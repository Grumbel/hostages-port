<component type="desktop-application">
  <id>org.grumbel.Hostages</id>
  <name>Hostages</name>
  <summary>Port of the Amiga version of Hostages (Infogrames, 1988)</summary>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer_name>Ingo Ruhnke</developer_name>
  <description>
    <p>
      A modern C++/SDL2 port that runs the original Amiga Hostages code on an
      emulated A500 (68000 interpreter, chipset, and limited OS HLE). Provide
      your own non-redistributable ADF disk image.
    </p>
  </description>
  <launchable type="desktop-id">hostages.desktop</launchable>
  <url type="homepage">https://github.com/Grumbel/hostages-port</url>
  <categories>
    <category>Game</category>
    <category>ActionGame</category>
  </categories>
  <recommends>
    <control>gamepad</control>
    <control>keyboard</control>
  </recommends>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.0" date="2026-10-26"/>
  </releases>
</component>
